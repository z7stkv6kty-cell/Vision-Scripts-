end

local function Toggle(parent, heading, description, key)
    local card = Section(parent, heading, description)
    local switch = Create("TextButton", {
        Size = UDim2.fromOffset(43, 23),
        Position = UDim2.new(1, -58, 0, 28),
        BackgroundColor3 = Theme.Border,
        Text = "",
        AutoButtonColor = false,
    }, card)
    Corner(switch, 20)

    local dot = Create("Frame", {
        Size = UDim2.fromOffset(17, 17),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.fromRGB(235, 238, 242),
        BorderSizePixel = 0,
    }, switch)
    Corner(dot, 20)

    local function Update()
        local enabled = State[key]
        TweenService:Create(switch, TweenInfo.new(.18), {
            BackgroundColor3 = enabled and Theme.Green or Theme.Border
        }):Play()
        TweenService:Create(dot, TweenInfo.new(.18), {
            Position = UDim2.fromOffset(enabled and 23 or 3, 3)
        }):Play()
    end

    switch.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        Update()
    end)
    Update()
    return card
end

local function Slider(parent, heading, key, min, max, suffix)
    local card = Section(parent, heading)
    card.Size = UDim2.new(1, 0, 0, 96)

    local valueText = Label(card, "", 11, Theme.Green, Enum.Font.GothamBold)
    valueText.Position = UDim2.new(1, -85, 0, 12)
    valueText.Size = UDim2.fromOffset(70, 18)
    valueText.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Create("TextButton", {
        Position = UDim2.fromOffset(14, 59),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = Theme.Border,
        Text = "",
        AutoButtonColor = false,
    }, card)
    Corner(bar, 8)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Green,
        BorderSizePixel = 0,
    }, bar)
    Corner(fill, 8)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.new(0, 0, .5, 0),
        BackgroundColor3 = Color3.fromRGB(245, 248, 250),
        BorderSizePixel = 0,
    }, bar)
    Corner(knob, 20)

    local function SetValue(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1
        )
        State[key] = math.floor((min + (max - min) * ratio) * 100) / 100
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, .5, 0)
        valueText.Text = tostring(State[key]) .. (suffix or "")
    end

    bar.MouseButton1Down:Connect(function()
        SetValue(UserInputService:GetMouseLocation().X)
        local connection
        connection = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                SetValue(input.Position.X)
            end
        end)
        local endConnection
        endConnection = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                connection:Disconnect()
                endConnection:Disconnect()
            end
        end)
    end)

    local ratio = (State[key] - min) / (max - min)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, 0, .5, 0)
    valueText.Text = tostring(State[key]) .. (suffix or "")
    return card
end

